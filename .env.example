# bleak-node configuration template. Copy to .env and adjust.
# Real environment variables always take precedence over values in .env.
# Point BLEAK_NODE_ENV_FILE at another file, or set it to "none" to skip loading.

# --- LLM (OpenAI-compatible chat completions endpoint) ---
# Endpoint of a vLLM/OVMS/OpenAI-style server. Local development default:
BLEAK_NODE_LLM_URL=http://localhost:8000/v1
# Served chat model id (see GET {BLEAK_NODE_LLM_URL}/models):
BLEAK_NODE_LLM_MODEL=qwen-agent
# Optional API key; required only by hosted gateways. Empty keeps local use.
# When both are unset, the server also falls back to OPENROUTER_API_KEY.
BLEAK_NODE_LLM_API_KEY=

# --- Agent worker ---
# BLEAK_NODE_AGENT=1            # 0 disables the agent worker entirely
# BLEAK_NODE_LLM_THINKING=1     # 0 silences Qwen-style reasoning channel
# BLEAK_NODE_CHAT_LIMIT=12      # per-participant message quota (6..12)
# BLEAK_NODE_AGENT_DEBATE=1     # 0 keeps chats networking-only (no part 2)

# --- Server ---
# BLEAK_NODE_ADDR=0.0.0.0:8080
# BLEAK_NODE_DB=bleak-node.db

# --- Git contributor identity (REQUIRED for commits) ---
# The single identity allowed to commit in this repo. .githooks reads
# these two keys on every commit and merge and declines anything else.
GITHUB_NAME=extube
GITHUB_EMAIL=extube@proton.me
